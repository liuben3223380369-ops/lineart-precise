<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- v1.14.0：固定浅色主题（原 DayNight + 强制白背景在系统暗色模式下
         文字变浅而背景仍白，对比度崩溃）。全部控件显式配色，见 colors.xml -->
    <style name="Theme.LineArt" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg_page</item>
        <item name="android:statusBarColor">@color/bg_card</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorControlActivated">@color/accent</item>
        <item name="colorControlNormal">@color/text_secondary</item>
    </style>
</resources>
